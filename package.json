{
  "name": "smartmart-platform",
  "version": "1.0.0",
  "private": true,
  "description": "SMARTMART — AI-Powered Real-Time Supermarket POS & Business Intelligence Platform",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run build:backend\" \"npm run build:frontend\"",
    "build:backend": "cd backend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "seed": "cd backend && npm run seed",
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
